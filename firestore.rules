rules_version = '2';
// =====================================================================
// YT Timecode筆記 — Firestore 安全規則
//
// 權限：
//   - 任何人都能讀取
//   - 新增影片、時間點、補充：需要登入（網站會自動匿名登入，使用者不會察覺）
//   - 修改：建立者本人（同一個瀏覽器）只能改自己的時間點、補充內容
//   - 刪除、修改全部內容：只有管理者
//
// 修改後要貼到 Firebase 控制台 → Firestore Database → 規則，按「發布」。
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共用檢查 ----------

    // 管理者 Google 帳號（要和 js/config.js 的 ADMIN_EMAILS 一致）
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['osht9478@gmail.com', 'su3cj3x04@gmail.com'];
    }
    function signedIn() { return request.auth != null; }
    function str(v, max) { return v is string && v.size() <= max; }
    function nonEmptyStr(v, max) { return str(v, max) && v.size() >= 1; }
    function tagList(v) { return v is list && v.size() <= 30; }
    function validTime(t) { return t is int && t >= 0 && t < 360000; }      // 100 小時內
    function isVideoId(id) { return id is string && id.matches('^[A-Za-z0-9_-]{11}$'); }
    function isAutoId(id) { return id.matches('^[A-Za-z0-9]{20}$'); }       // Firestore 自動 ID
    function data() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function ownedBySelf() {
      return signedIn() && 'uid' in resource.data && resource.data.uid == request.auth.uid;
    }

    // ---------- 影片：videos/{影片ID} ----------
    match /videos/{videoId} {
      allow read: if true;

      allow create: if signedIn()
        && isVideoId(videoId)
        && data().keys().hasOnly(['title', 'channel', 'tags', 'createdBy', 'createdAt', 'updatedAt', 'publishedAt'])
        && str(data().title, 200)
        && str(data().channel, 100)
        && tagList(data().tags)
        && str(data().createdBy, 40)
        && data().get('publishedAt', 0) is int
        && data().createdAt == request.time
        && data().updatedAt == request.time;

      // 一般人：只能更新時間、追加 Hashtag、補上原本空白的標題／頻道／發布日期
      allow update: if isAdmin() || (
        signedIn()
        && changed().hasOnly(['updatedAt', 'tags', 'title', 'channel', 'publishedAt'])
        && (!('updatedAt' in changed()) || data().updatedAt == request.time)
        && tagList(data().tags)
        && data().tags.hasAll(resource.data.tags.removeAll(['待補']))   // 只能新增 Hashtag，唯一能移除的是「待補」
        && str(data().title, 200)
        && str(data().channel, 100)
        && (data().title == resource.data.title || resource.data.title == '')
        && (data().channel == resource.data.channel || resource.data.channel == '')
        && data().get('publishedAt', 0) is int
        && (resource.data.get('publishedAt', 0) == 0 || data().get('publishedAt', 0) == resource.data.get('publishedAt', 0))
      );

      allow delete: if isAdmin();
    }

    // ---------- 時間點：marks/{自動ID} ----------
    match /marks/{markId} {
      allow read: if true;

      allow create: if signedIn()
        && isAutoId(markId)
        && data().keys().hasOnly(['videoId', 't', 'note', 'author', 'createdAt', 'uid'])
        && data().uid == request.auth.uid
        && isVideoId(data().videoId)
        && existsAfter(/databases/$(database)/documents/videos/$(data().videoId))
        && (data().t == null || validTime(data().t))   // 時間碼可不填
        && str(data().note, 2000)
        && nonEmptyStr(data().author, 40)
        && data().createdAt == request.time;

      // 建立者本人只能改時間和備註
      allow update: if isAdmin() || (
        ownedBySelf()
        && changed().hasOnly(['t', 'note'])
        && (data().t == null || validTime(data().t))
        && str(data().note, 2000)
      );

      allow delete: if isAdmin();
    }

    // ---------- 補充評論：comments/{自動ID} ----------
    match /comments/{commentId} {
      allow read: if true;

      allow create: if signedIn()
        && isAutoId(commentId)
        && data().keys().hasOnly(['videoId', 'markId', 'text', 'author', 'createdAt', 'uid'])
        && data().uid == request.auth.uid
        && data().markId is string
        && existsAfter(/databases/$(database)/documents/marks/$(data().markId))
        && getAfter(/databases/$(database)/documents/marks/$(data().markId)).data.videoId == data().videoId
        && nonEmptyStr(data().text, 2000)
        && nonEmptyStr(data().author, 40)
        && data().createdAt == request.time;

      // 留言者本人只能改內容
      allow update: if isAdmin() || (
        ownedBySelf()
        && changed().hasOnly(['text'])
        && nonEmptyStr(data().text, 2000)
      );

      allow delete: if isAdmin();
    }
  }
}
